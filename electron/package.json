{
  "name": "soundshredder-desktop",
  "productName": "SoundShredder",
  "version": "1.3.0",
  "description": "Local audio cleanup for the Higgsfield community",
  "author": "cyr4x",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:app": "node tests/lifecycle.cjs",
    "test:setup-ui": "node tests/setup-ui.cjs",
    "test:storage-ui": "node tests/storage-ui.cjs",
    "test:updates-ui": "node tests/updates-ui.cjs",
    "test:updates-native": "node tests/update-native.cjs",
    "test:upgrade": "node tests/upgrade.cjs",
    "test:lab-ui": "node tests/lab-extraction-ui.cjs && node tests/lab-session-ui.cjs",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "linkedom": "0.18.13",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
